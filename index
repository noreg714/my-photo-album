<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> My Photo Gallery</title>
  <!-- 載入 Lightgallery 相簿套件樣式 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lightgallery.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lg-zoom.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lg-thumbnail.min.css">
  <style>
    body {
      margin: 0;
      padding: 40px 20px;
      background-color: #121212; /* 深色高質感背景 */
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    h1 {
      text-align: center;
      margin-bottom: 40px;
      font-weight: 300;
      letter-spacing: 2px;
    }
    /* 瀑布流 / 網格相簿排版 */
    .gallery-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 15px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .gallery-item {
      display: block;
      overflow: hidden;
      border-radius: 8px;
      aspect-ratio: 4 / 3;
      background-color: #222;
      transition: transform 0.3s ease;
    }
    .gallery-item:hover {
      transform: scale(1.02);
    }
    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>
</head>
<body>

  <h1>PHOTO COLLECTION</h1>

  <!-- 相簿列表：根據你上載的圖片檔名修改或增減 -->
  <div class="gallery-container" id="lightgallery">
    <a href="https://cdn.myportfolio.com/8dbe8680-2e62-483d-a4d4-575a8201de1f/8187ae22-a34e-4131-b01a-f4370a506d21_rw_1920.JPG?h=c327ef733efe351080f0a5e17db39d77" class="gallery-item">
      <img src="https://cdn.myportfolio.com/8dbe8680-2e62-483d-a4d4-575a8201de1f/8187ae22-a34e-4131-b01a-f4370a506d21_rw_1920.JPG?h=c327ef733efe351080f0a5e17db39d77" alt="Photo 1" />
    </a>
    <a href="https://raw.githubusercontent.com/noreg714/my-photo-album/refs/heads/main/CEC41327-74A5-4698-BEE0-769FBCDDC45A.jpg" class="gallery-item">
      <img src="https://raw.githubusercontent.com/noreg714/my-photo-album/refs/heads/main/CEC41327-74A5-4698-BEE0-769FBCDDC45A.jpg" alt="Photo 2" />
    </a>
    <a href="https://raw.githubusercontent.com/noreg714/my-photo-album/refs/heads/main/CEC41327-74A5-4698-BEE0-769FBCDDC45A.jpg" class="gallery-item">
      <img src="https://raw.githubusercontent.com/noreg714/my-photo-album/refs/heads/main/CEC41327-74A5-4698-BEE0-769FBCDDC45A.jpg" alt="Photo 3" />
    </a>
  </div>

  <!-- 載入 Lightgallery 腳本 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.css"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/zoom/lg-zoom.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/thumbnail/lg-thumbnail.min.js"></script>

  <script>
    lightGallery(document.getElementById('lightgallery'), {
      plugins: [lgZoom, lgThumbnail],
      speed: 500,
    });
  </script>
</body>
</html>
